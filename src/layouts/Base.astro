---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { siteName, description as defaultDescription, community, repository, path } from '../lib/site';
const { title = siteName, description = defaultDescription, article = false, date } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(path('images/social-card.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" /><meta name="theme-color" content="#f5f4ef" />
    <title>{title === siteName ? title : `${title} | ${siteName}`}</title>
    <meta name="description" content={description} /><link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={path('favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={path('rss.xml')} />
    <meta property="og:site_name" content={siteName} /><meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <script is:inline>try { const t = localStorage.getItem('breatic.blog.theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href={path()} aria-label="Breatic Journal home"><img src={path('images/mark.svg')} width="34" height="34" alt="" /><span>Breatic<span class="brand-sub">Journal</span></span></a>
      <nav aria-label="Main navigation">
        <a href={path('engineering/')}>Engineering</a><a href={path('product-updates/')}>Product updates</a>
        <a class="icon-link" href={community} target="_blank" rel="noopener noreferrer">Community <Icon name="external-link" /></a>
        <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">◐</button>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href={path()}>Breatic Journal</a><p>Building a shared space for creative work.</p></div>
      <nav aria-label="Footer navigation"><a class="icon-link" href="https://breatic.ai" target="_blank" rel="noopener noreferrer">Breatic <Icon name="external-link" /></a><a class="icon-link" href={repository} target="_blank" rel="noopener noreferrer">Source <Icon name="external-link" /></a><a class="icon-link" href={path('rss.xml')}>RSS <Icon name="rss" /></a><a class="icon-link" href="https://breatic.ai/privacy/" target="_blank" rel="noopener noreferrer">Privacy <Icon name="external-link" /></a></nav>
      <small>© {new Date().getUTCFullYear()} Orime, Inc.</small>
    </footer>
    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark'; root.dataset.theme = next;
        try { localStorage.setItem('breatic.blog.theme', next); } catch {}
        document.querySelectorAll<HTMLIFrameElement>('iframe.giscus-frame').forEach((frame) => frame.contentWindow?.postMessage({ giscus: { setConfig: { theme: next } } }, 'https://giscus.app'));
      });
    </script>
  </body>
</html>
