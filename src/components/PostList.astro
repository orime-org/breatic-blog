---
import { path, dateLabel } from '../lib/site';
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map((post) => <article class="post-row">
    <div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time></div>
    <div><h2><a href={path(`${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p></div>
  </article>)}
</div>
