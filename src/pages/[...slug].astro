---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import TrimDemo from '../components/TrimDemo.astro';
import { path, dateLabel } from '../lib/site';
export async function getStaticPaths() { return (await getCollection('posts', ({ data }) => !data.draft)).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props; const { Content, headings } = await render(post);
const words = post.body?.split(/\s+/).length || 0;
const json = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), author: { '@type': 'Organization', name: post.data.author }, publisher: { '@type': 'Organization', name: 'Orime, Inc.' }, mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href };
---
<Base title={post.data.title} description={post.data.description} article date={post.data.date}>
  <article>
    <header class="article-header wrap"><a class="back-link" href={path(post.data.category === 'Engineering' ? 'engineering/' : 'product-updates/')}>← {post.data.category}</a><p class="eyebrow">{post.data.category}</p><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="byline"><span>{post.data.author}</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{Math.max(1, Math.ceil(words / 200))} min read</span></div></header>
    <div class="article-grid wrap"><aside class="article-aside"><p class="eyebrow">In this article</p><nav aria-label="Table of contents">{headings.filter((h) => h.depth === 2).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav><a class="aside-rss" href={path('rss.xml')}>Follow the journal ↗</a></aside><div class="article-body"><div class="prose"><Content /></div>{post.id === 'trimming-web-animations' && <TrimDemo />}<Comments number={post.data.discussion} /></div></div>
  </article><script type="application/ld+json" set:html={JSON.stringify(json).replace(/</g, '\u003c')} />
</Base>
